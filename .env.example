# NEXT_PUBLIC_APP_URL=http://localhost:3000
# NEXT_PUBLIC_SITE_NAME=VDB Digital Software
# NEXT_PUBLIC_CONTACT_EMAIL=
# NEXT_PUBLIC_SUPPORT_EMAIL=

# --- Checkout (ALWAYS OFF unless operators manually enable after P0.5 READY) ---
CHECKOUT_ENABLED=false
# Never set CHECKOUT_ENABLED=true during P0.5. Missing variable also means OFF.

# Supabase (publiek + server)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=   # legacy alias
# SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=       # legacy/deprecated — gebruik SUPABASE_SECRET_KEY

# Appointment scheduling (Cal.com, Calendly, Google Calendar, etc.)
# BOOKING_ENABLED=1
# BOOKING_PROVIDER=calcom
# Safe values: calcom | google | calendly | external | disabled
# BOOKING_PROVIDER_URL=https://cal.com/your-link
# BOOKING_ONLINE_URL=
# BOOKING_IN_PERSON_URL=

# Founding Client Offer (disabled by default — do not enable until benefits approved)
# FOUNDING_CLIENT_ENABLED=0
# FOUNDING_CLIENT_MAX=10
# FOUNDING_CLIENT_START_DATE=
# FOUNDING_CLIENT_END_DATE=

# Mollie — use test_ keys for local/preview; live_ only on production after go-live
# MOLLIE_API_KEY=test_...
# MOLLIE_WEBHOOK_TOKEN=          # optioneel applicatietoken (geen Mollie signature)
# MOLLIE_WEBHOOK_SECRET=         # legacy alias — migrate to TOKEN
# VERCEL_AUTOMATION_BYPASS_SECRET=  # alleen Preview + Deployment Protection

# Resend — production EMAIL_FROM must be a verified domain (no placeholders)
# RESEND_API_KEY=
# EMAIL_FROM=
# EMAIL_ADMIN=
# EMAIL_ALLOWED_FROM_DOMAINS=vdbdigital.nl
# RESEND_TEST_TO=

# WhatsApp
# NEXT_PUBLIC_WHATSAPP_NUMBER=

# Application rate limiting (required for checkout/payment fail-open prevention)
# Prefer DB RPC check_rate_limit after migrations, or Upstash:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Extra exact origins for CSRF checks (comma-separated full origins)
# ALLOWED_ORIGINS=

# Turnstile (optional)
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# P0.5 operator confirmations for release-gate CLI (never secrets)
# P05_MIGRATION_APPLIED=1
# P05_LIMITER_RPC_VERIFIED=1
# P05_MOLLIE_TEST_VERIFIED=1

# Bootstrap owner (CLI only, niet committen)
# BOOTSTRAP_USER_ID=
# BOOTSTRAP_USER_EMAIL=

# Force productie-env validatie bij Vercel build
# REQUIRE_PRODUCTION_ENV=1

# ---------------------------------------------------------------------------
# App Download Banner (FEATURE-FLAGGED — default OFF)
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_APP_DOWNLOAD_BANNER_ENABLED=false
# Master switch. MUST remain false until:
#   - The VDB Digital app is publicly available in both the App Store and Play Store.
#   - Real, confirmed store links have been verified.
#   - The full VDB Digital release checklist has passed.
# Any other value (including missing) keeps the banner hidden.

# NEXT_PUBLIC_APP_DEEP_LINK_URL=
# URI scheme to open the app directly. Example: vdbdigital://home
# Leave empty until deep links are tested with Android App Links / iOS Universal Links.

# NEXT_PUBLIC_ANDROID_APP_STORE_URL=
# Google Play Store URL. Example: https://play.google.com/store/apps/details?id=nl.vdbdigital
# Leave empty when the app is not yet published.

# NEXT_PUBLIC_IOS_APP_STORE_URL=
# Apple App Store URL. Example: https://apps.apple.com/nl/app/vdb-digital/id123456789
# Leave empty when the app is not yet published.

# NEXT_PUBLIC_IOS_APP_STORE_ID=
# Numeric App Store ID for the iOS Smart App Banner meta tag.
# Example: 123456789
# Leave empty until the app is live in the App Store.

# NEXT_PUBLIC_APP_BANNER_DELAY_MS=12000
# Milliseconds before the banner appears after page load. Default: 12000 (12 seconds).

# NEXT_PUBLIC_APP_BANNER_DISMISS_DAYS=30
# Days the banner stays hidden after a visitor dismisses it. Default: 30.

# NEXT_PUBLIC_APP_BANNER_VERSION=v1
# Storage key version. Bump to v2, v3 etc. to re-show the banner after a major update.

# ---------------------------------------------------------------------------
# Monetization / Promotion Foundation (FEATURE-FLAGGED — default OFF)
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_PROMOTION_ENABLED=false
# Master switch for RevenuePromotionCard blocks (own services, affiliate, sponsored).
# Keep false until editorial and compliance review is complete.
