# --- Runtime target ---
# Local: development. Cloudflare production/preview is set in wrangler.jsonc.
VDB_DEPLOYMENT_ENV=development
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# NEXT_PUBLIC_SITE_NAME=VDB Digital Software
# NEXT_PUBLIC_CONTACT_EMAIL=
# NEXT_PUBLIC_SUPPORT_EMAIL=

# --- Checkout ---
# Safe local default. Production value is controlled in wrangler.jsonc.
CHECKOUT_ENABLED=false

# Supabase (public + server-only)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=   # legacy alias
# SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=       # legacy/deprecated

# Public form ingress secret
# PUBLIC_FORM_RPC_SECRET=

# Appointment scheduling
# BOOKING_ENABLED=1
# BOOKING_PROVIDER=calendly
# Safe values: calcom | google | calendly | external | disabled
# BOOKING_PROVIDER_URL=https://calendly.com/your-link
# BOOKING_ONLINE_URL=
# BOOKING_IN_PERSON_URL=

# Founding Client Offer
# FOUNDING_CLIENT_ENABLED=0
# FOUNDING_CLIENT_MAX=10
# FOUNDING_CLIENT_START_DATE=
# FOUNDING_CLIENT_END_DATE=

# Mollie — test_ for local/preview; live_ is accepted only on Cloudflare production
# MOLLIE_API_KEY=test_...
# MOLLIE_WEBHOOK_TOKEN=
# MOLLIE_WEBHOOK_SECRET=         # legacy alias

# Resend — EMAIL_FROM must use a verified domain
# RESEND_API_KEY=
# EMAIL_FROM=VDB Digital Software <noreply@vdbdigital.nl>
# EMAIL_ADMIN=algemeen@vdbdigital.nl
# EMAIL_ALLOWED_FROM_DOMAINS=vdbdigital.nl
# RESEND_TEST_TO=
# RESEND_MARKETING_SEGMENT_ID=
# RESEND_MARKETING_TOPIC_ID=

# Google Places (New) — server secret, never NEXT_PUBLIC
# GOOGLE_PLACES_API_KEY=

# Google OAuth UI switch
# GOOGLE_AUTH_ENABLED=1

# WhatsApp
# NEXT_PUBLIC_WHATSAPP_NUMBER=

# Rate limiting
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Extra exact origins for CSRF checks
# ALLOWED_ORIGINS=

# Turnstile (optional)
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Legacy checkout verification confirmations
# P05_MIGRATION_APPLIED=1
# P05_LIMITER_RPC_VERIFIED=1
# P05_MOLLIE_TEST_VERIFIED=1

# Bootstrap owner (CLI only; never commit real values)
# BOOTSTRAP_USER_ID=
# BOOTSTRAP_USER_EMAIL=

# Explicitly enable strict production validation for a release build/check
# REQUIRE_PRODUCTION_ENV=1
